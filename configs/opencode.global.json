{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "plugin": [
    "opencode-claude-auth@latest",
    "@prevalentware/opencode-goal-plugin"
  ],
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "thinking": {
        "type": "enabled"
      },
      "disable": false
    },
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-5",
      "disable": false
    },
    "general": {
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.1,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "thinking": {
        "type": "enabled"
      },
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}
